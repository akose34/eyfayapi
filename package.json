{
  "name": "eyfayapi",
  "version": "0.1.0",
  "private": true,
  "description": "Eyfa Yapı corporate website — Astro static rebuild (redesign/eyfa-professional).",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/verify-dist.mjs",
    "validate": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.10",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
