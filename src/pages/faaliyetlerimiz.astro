---
import MediaFrame from '@/components/MediaFrame.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { activities } from '@/data/activities';
---

<BaseLayout title="Faaliyetlerimiz" description="Eyfa Yapı kurumsal faaliyetleri.">
  <PageHeader title="Faaliyetlerimiz" eyebrow="Kurumsal" breadcrumbs={[{ label: 'Faaliyetler' }]} />

  <Section>
    <ul class="grid gap-x-(--spacing-grid) gap-y-16 md:grid-cols-2">
      {activities.map((activity) => (
        <li class="reveal">
          <article>
            <MediaFrame
              src={activity.image}
              alt={activity.alt}
              aspect="square"
              position="50% 0%"
              widths={[400, 640, 900]}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
            <h2 class="mt-8 text-3xl">{activity.title}</h2>
            <p class="text-ink-muted mt-4 max-w-md">{activity.description}</p>
          </article>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
