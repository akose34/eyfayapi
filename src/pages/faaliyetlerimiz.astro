---
import { Image } from 'astro:assets';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { activities } from '@/data/activities';
import { legacyImage } from '@/lib/media';
---

<BaseLayout title="Faaliyetlerimiz" description="Eyfa Yapı kurumsal faaliyetleri.">
  <Container class="py-section">
    <p class="eyebrow">Kurumsal</p>
    <h1 class="mt-3 text-(length:--text-5xl)">Faaliyetlerimiz</h1>
    <ul class="mt-12 grid gap-8 md:grid-cols-2">
      {activities.map((activity) => (
        <li class="bg-surface-raised border-line overflow-hidden rounded-lg border">
          <Image
            src={legacyImage(activity.image)}
            alt={activity.alt}
            widths={[400, 640, 900]}
            width={900}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-square w-full object-cover object-top"
          />
          <div class="p-8">
            <h2 class="text-(length:--text-2xl)">{activity.title}</h2>
            <p class="text-ink-muted mt-3">{activity.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </Container>
</BaseLayout>
