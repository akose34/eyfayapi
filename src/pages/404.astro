---
import Button from '@/components/Button.astro';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Sayfa bulunamadı" noindex>
  <Container width="prose" class="py-section text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-(length:--text-5xl)">Sayfa bulunamadı</h1>
    <p class="text-ink-muted mt-6">Aradığınız sayfa taşınmış veya kaldırılmış olabilir.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <Button href="/">Ana sayfaya dön</Button>
      <Button href="/projeler/" variant="secondary">
        Projelerimiz
      </Button>
    </div>
  </Container>
</BaseLayout>
