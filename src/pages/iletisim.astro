---
import Button from '@/components/Button.astro';
import ContactLinks from '@/components/ContactLinks.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { company } from '@/data/company';
import { whatsappHref } from '@/lib/contact';

const { district, city } = company.address;
---

<BaseLayout
  title="İletişim"
  description={`Eyfa Yapı iletişim bilgileri: ${company.phones[0].display}, ${company.email}, ${district}/${city}.`}
>
  <PageHeader
    title="Bize ulaşın"
    eyebrow="İletişim"
    lead="Telefon, WhatsApp veya e-posta ile bize doğrudan ulaşabilirsiniz."
    breadcrumbs={[{ label: 'İletişim' }]}
    width="wide"
  >
    <div class="mt-10">
      <Button href={whatsappHref(company.whatsapp.e164)} external leadingIcon="whatsapp" size="lg">
        WhatsApp ile yazın
      </Button>
    </div>
  </PageHeader>

  <Section width="wide" labelledby="iletisim-bilgileri">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-(--spacing-grid)">
      <div class="lg:col-span-4">
        <h2 id="iletisim-bilgileri" class="text-3xl">
          İletişim bilgileri
        </h2>
        <p class="text-ink-muted mt-3 text-sm">{company.legalName}</p>
        <ContactLinks address class="mt-10" />
      </div>
      <div class="lg:col-span-8">
        <iframe
          src={company.mapEmbedUrl}
          title="Eyfa Yapı ofis konumu — Google Haritalar"
          class="border-line aspect-landscape w-full rounded-lg border lg:aspect-photo"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </Section>
</BaseLayout>
