---
/**
 * Homepage — Stage 2 applies the shared design system to the Stage 1 content.
 * The full homepage composition (hero media, featured projects, corporate
 * band) is Stage 3 (docs/ROADMAP.md).
 */
import Button from '@/components/Button.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Container from '@/components/Container.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import MediaFrame from '@/components/MediaFrame.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TextLink from '@/components/TextLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { company, legacyCopy } from '@/data/company';
import { services } from '@/data/services';
---

<BaseLayout>
  <section class="tone-dark border-line border-t" aria-labelledby="hero-title">
    <Container width="wide" class="py-section grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Eyebrow>{company.brandName}</Eyebrow>
        <h1 id="hero-title" class="mt-6 text-display">
          {legacyCopy.homeHeadline}
        </h1>
        <p class="text-ink-muted mt-8 max-w-xl text-lg">{legacyCopy.homeIntro}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/projeler/" size="lg" icon="arrow-right">
            Projelerimiz
          </Button>
          <Button href="/iletisim/" variant="secondary" size="lg">
            İletişim
          </Button>
        </div>
      </div>
      <MediaFrame
        src="img/Eyfa-yapi-resim17.png"
        alt="Yeşil çatılı, sarı cephe şeritli konut binasının havadan görünümü"
        aspect="photo"
        widths={[480, 768, 1024, 1440]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        priority
        class="lg:col-span-6"
      />
    </Container>
  </section>

  <Section labelledby="hizmetler-baslik">
    <SectionHeading eyebrow="Hizmetlerimiz" title="Neler yapıyoruz" id="hizmetler-baslik">
      <TextLink slot="action" href="/hizmetler/">
        Tüm hizmetler
      </TextLink>
    </SectionHeading>
    <ul class="mt-14 grid gap-(--spacing-grid) md:grid-cols-3">
      {services.map((service, index) => (
        <li class="reveal">
          <ServiceCard service={service} index={index} />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="sand" labelledby="projeler-baslik">
    <SectionHeading
      eyebrow="Projelerimiz"
      title="Projelerimiz"
      lead={legacyCopy.projectsIntro}
      id="projeler-baslik"
    >
      <Button slot="action" href="/projeler/" variant="secondary" icon="arrow-right">
        Tüm Projelerimiz
      </Button>
    </SectionHeading>
  </Section>

  <ContactCTA />
</BaseLayout>
