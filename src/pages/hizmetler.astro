---
import Container from '@/components/Container.astro';
import StageNotice from '@/components/StageNotice.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { services } from '@/data/services';
---

<BaseLayout
  title="Hizmetlerimiz"
  description="Eyfa Yapı hizmetleri: mimarlık, mühendislik ve emlak."
>
  <Container class="py-section">
    <p class="eyebrow">Hizmetlerimiz</p>
    <h1 class="mt-3 text-(length:--text-5xl)">Hizmetlerimiz</h1>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <li id={service.id} class="bg-surface-raised border-line rounded-lg border p-8">
          <h2 class="text-(length:--text-2xl)">{service.title}</h2>
          <p class="text-ink-muted mt-3">{service.description}</p>
        </li>
      ))}
    </ul>
    <div class="mt-12">
      <StageNotice>
        Hizmet detayları için metinler mevcut siteden alınmıştır. Genişletilmiş hizmet açıklamaları
        firma onayı ile eklenecektir.
      </StageNotice>
    </div>
  </Container>
</BaseLayout>
