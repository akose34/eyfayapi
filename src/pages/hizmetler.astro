---
import ContactCTA from '@/components/ContactCTA.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import StageNotice from '@/components/StageNotice.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { services } from '@/data/services';
---

<BaseLayout
  title="Hizmetlerimiz"
  description="Eyfa Yapı hizmetleri: mimarlık, mühendislik ve emlak."
>
  <PageHeader
    title="Hizmetlerimiz"
    eyebrow="Uzmanlık alanlarımız"
    breadcrumbs={[{ label: 'Hizmetler' }]}
  />

  <Section>
    <ul class="grid gap-(--spacing-grid) md:grid-cols-3">
      {services.map((service, index) => (
        <li class="reveal">
          <ServiceCard service={service} index={index} headingLevel="h2" />
        </li>
      ))}
    </ul>
    <StageNotice class="mt-12 max-w-(--container-prose)">
      Hizmet açıklamaları mevcut siteden alınmıştır. Genişletilmiş hizmet içerikleri firma onayı ile
      eklenecektir.
    </StageNotice>
  </Section>

  <ContactCTA />
</BaseLayout>
