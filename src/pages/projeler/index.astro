---
import { Image } from 'astro:assets';
import Container from '@/components/Container.astro';
import StageNotice from '@/components/StageNotice.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { legacyCopy } from '@/data/company';
import { projectDisplayName, projects } from '@/data/projects';
import { legacyImage } from '@/lib/media';
---

<BaseLayout title="Projelerimiz" description={legacyCopy.projectsIntro}>
  <Container width="wide" class="py-section">
    <p class="eyebrow">Portföy</p>
    <h1 class="mt-3 text-(length:--text-5xl)">Projelerimiz</h1>
    <p class="prose-eyfa mt-6">{legacyCopy.projectsIntro}</p>

    <div class="mt-10">
      <StageNotice title="Proje bilgileri onay bekliyor">
        Mevcut sitede proje adları, konumları ve açıklamaları bulunmamaktadır. Aşağıdaki galeriler
        mevcut sitedeki sırayla geçici olarak numaralandırılmıştır; bilgiler firma tarafından
        onaylandıktan sonra eklenecektir.
      </StageNotice>
    </div>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <li>
          <a href={`/projeler/${project.slug}/`} class="group block">
            <Image
              src={legacyImage(project.cover.src)}
              alt={project.cover.alt}
              widths={[400, 640, 900]}
              width={900}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              class="bg-ivory-200 aspect-[4/3] w-full rounded-lg object-cover"
            />
            <h2 class="group-hover:text-accent-strong mt-4 text-(length:--text-2xl)">
              {projectDisplayName(project)}
            </h2>
            <p class="text-ink-muted text-sm">{project.gallery.length} görsel</p>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</BaseLayout>
