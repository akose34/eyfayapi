---
import PageHeader from '@/components/PageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Section from '@/components/Section.astro';
import StageNotice from '@/components/StageNotice.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { legacyCopy } from '@/data/company';
import { projects } from '@/data/projects';
---

<BaseLayout title="Projelerimiz" description={legacyCopy.projectsIntro}>
  <PageHeader
    title="Projelerimiz"
    eyebrow="Portföy"
    lead={legacyCopy.projectsIntro}
    breadcrumbs={[{ label: 'Projeler' }]}
    width="wide"
  />

  <Section width="wide">
    <StageNotice title="Proje bilgileri onay bekliyor" class="max-w-(--container-prose)">
      Mevcut sitede proje adları, konumları ve açıklamaları bulunmamaktadır. Galeriler mevcut
      sitedeki sırayla geçici olarak numaralandırılmıştır; bilgiler firma tarafından onaylandıktan
      sonra eklenecektir.
    </StageNotice>

    <h2 class="sr-only">Proje galerileri</h2>
    <ul class="mt-14 grid gap-x-(--spacing-grid) gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, index) => (
        <li class="reveal">
          <ProjectCard project={project} priority={index < 3} />
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
