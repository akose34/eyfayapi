---
import type { GetStaticPaths } from 'astro';
import MediaFrame from '@/components/MediaFrame.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import StageNotice from '@/components/StageNotice.astro';
import TextLink from '@/components/TextLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projectDisplayName, projects } from '@/data/projects';
import type { Project } from '@/types/content';

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const title = projectDisplayName(project);
const confirmed = project.name.status === 'VERIFIED';
---

<BaseLayout title={title} ogImage={project.cover.src} noindex={!confirmed}>
  <PageHeader
    title={title}
    eyebrow="Proje"
    breadcrumbs={[{ label: 'Projeler', href: '/projeler/' }, { label: title }]}
    width="wide"
  />

  <Section width="wide">
    {!confirmed && (
      <StageNotice title="Proje bilgileri onay bekliyor" class="max-w-(--container-prose)">
        Bu galeri mevcut sitedeki {project.legacyOrder}. proje galerisidir. Proje adı, konumu ve
        açıklaması firma tarafından onaylandıktan sonra eklenecektir.
      </StageNotice>
    )}

    <h2 class="sr-only">Proje görselleri</h2>
    <ul class="mt-12 grid gap-(--spacing-grid) sm:grid-cols-2 lg:grid-cols-3">
      {project.gallery.map((image, index) => (
        <li>
          <MediaFrame
            src={image.src}
            alt={`${image.alt} (${index + 1}/${project.gallery.length})`}
            aspect="landscape"
            fit={image.kind === 'floor-plan' ? 'contain' : 'cover'}
            widths={[400, 640, 900, 1280]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            priority={index < 3}
          />
        </li>
      ))}
    </ul>

    <TextLink href="/projeler/" class="mt-14" arrow={false}>
      Tüm projelere dön
    </TextLink>
  </Section>
</BaseLayout>
