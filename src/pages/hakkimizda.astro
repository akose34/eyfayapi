---
import Divider from '@/components/Divider.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import StageNotice from '@/components/StageNotice.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { legacyCopy } from '@/data/company';
---

<BaseLayout
  title="Hakkımızda"
  description="EYFA Yapı, 2004 yılında İstanbul’da kurulmuş, konut ve taahhüt projeleri alanında faaliyet gösteren bir inşaat firmasıdır."
>
  <PageHeader
    title="Hakkımızda"
    eyebrow="Kurumsal"
    lead={legacyCopy.positioning}
    breadcrumbs={[{ label: 'Hakkımızda' }]}
  />

  <Section>
    <div class="prose-eyfa">
      {legacyCopy.aboutCompany.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <ul>
        {legacyCopy.aboutCompanyList.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      {legacyCopy.aboutCompanyClosing.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </Section>

  <Section tone="sand" labelledby="misyon-vizyon">
    <h2 id="misyon-vizyon" class="sr-only">
      Misyon ve vizyon
    </h2>
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-(--spacing-grid)">
      <div class="reveal">
        <Divider variant="accent" />
        <h3 class="mt-6 text-4xl">Misyonumuz</h3>
        <p class="text-ink-muted mt-6 text-lg">{legacyCopy.mission}</p>
      </div>
      <div class="reveal">
        <Divider variant="accent" />
        <h3 class="mt-6 text-4xl">Vizyonumuz</h3>
        <p class="text-ink-muted mt-6 text-lg">{legacyCopy.vision}</p>
      </div>
    </div>
  </Section>

  <Section spacing="compact">
    <StageNotice title="Kurucu biyografisi onay bekliyor" class="max-w-(--container-prose)">
      Mevcut sitedeki kurucu biyografisi yaş ve öğrenim durumu gibi zamanla değişen bilgiler
      içerdiği için, güncel metin firma tarafından onaylandıktan sonra eklenecektir.
    </StageNotice>
  </Section>
</BaseLayout>
