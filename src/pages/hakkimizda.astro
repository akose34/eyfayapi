---
import Container from '@/components/Container.astro';
import StageNotice from '@/components/StageNotice.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { legacyCopy } from '@/data/company';
---

<BaseLayout
  title="Hakkımızda"
  description="EYFA Yapı, 2004 yılında İstanbul’da kurulmuş, konut ve taahhüt projeleri alanında faaliyet gösteren bir inşaat firmasıdır."
>
  <Container width="prose" class="py-section">
    <p class="eyebrow">Kurumsal</p>
    <h1 class="mt-3 text-(length:--text-5xl)">Hakkımızda</h1>
    <div class="prose-eyfa mt-10">
      {legacyCopy.aboutCompany.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <ul class="list-disc space-y-1 pl-6">
        {legacyCopy.aboutCompanyList.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      {legacyCopy.aboutCompanyClosing.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <h2 class="mt-16 text-(length:--text-3xl)">Misyonumuz</h2>
    <p class="prose-eyfa mt-4">{legacyCopy.mission}</p>

    <h2 class="mt-12 text-(length:--text-3xl)">Vizyonumuz</h2>
    <p class="prose-eyfa mt-4">{legacyCopy.vision}</p>

    <div class="mt-16">
      <StageNotice title="Kurucu biyografisi onay bekliyor">
        Mevcut sitedeki kurucu biyografisi yaş ve öğrenim durumu gibi zamanla değişen bilgiler
        içerdiği için, güncel metin firma tarafından onaylandıktan sonra eklenecektir.
      </StageNotice>
    </div>
  </Container>
</BaseLayout>
