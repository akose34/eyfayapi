/**
 * Inline SVG icon set (no icon font, no runtime dependency).
 *
 * - Stroke icons: 24×24 grid, 1.5px stroke, currentColor — drawn for this project.
 * - Brand glyphs (whatsapp, instagram): the filled paths already used on the
 *   legacy site, kept for recognisability.
 *
 * Icons are decorative by default (aria-hidden). Pass `label` only when the
 * icon is the sole content of a control and has no visible text.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-up'
  | 'chevron-right'
  | 'menu'
  | 'close'
  | 'phone'
  | 'mail'
  | 'map-pin'
  | 'image-off'
  | 'whatsapp'
  | 'instagram';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string | undefined;
}

