---
/**
 * Editorial image + text row (Stage 5). Alternates sides with `reverse`, so a
 * sequence of rows reads as a zigzag instead of a card grid. DOM order is
 * always text → image, so reading order is stable on every layout.
 *
 * Image widths deliberately match ProjectGallery thumbnails
 * (480/750/960/1280, photo quality 72): Astro hashes identical transforms to
 * the same file, so these rows reuse existing derivatives instead of growing
 * the build.
 */
import MediaFrame from './MediaFrame.astro';

interface Props {
  image: { src: string; alt: string; position?: string };
  reverse?: boolean;
  aspect?: 'portrait' | 'photo' | 'landscape';
  /** Content column width on large screens (of 12). */
  textSpan?: 5 | 6;
  class?: string | undefined;
}

const { image, reverse = false, aspect = 'photo', textSpan = 5, class: className } = Astro.props;
const imageSpan = textSpan === 5 ? 'lg:col-span-6' : 'lg:col-span-5';
---

<div class:list={['grid items-center gap-10 lg:grid-cols-12 lg:gap-(--spacing-grid)', className]}>
  <div
    class:list={[
      textSpan === 5 ? 'lg:col-span-5' : 'lg:col-span-6',
      reverse ? 'lg:order-2 lg:col-start-8' : 'lg:order-1',
    ]}
  >
    <slot />
  </div>
  <MediaFrame
    src={image.src}
    alt={image.alt}
    aspect={aspect}
    widths={[480, 750, 960, 1280]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    {...(image.position ? { position: image.position } : {})}
    class:list={[
      imageSpan,
      'reveal',
      reverse ? 'lg:order-1 lg:row-start-1' : 'lg:order-2 lg:col-start-7',
    ]}
  />
</div>
