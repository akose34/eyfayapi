---
/**
 * Contact call-to-action band. Uses only verified channels (phone, WhatsApp,
 * e-mail). The heading/lead are neutral UI copy, not company claims.
 */
import Button from './Button.astro';
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import TextLink from './TextLink.astro';
import { company } from '@/data/company';
import { mailtoHref, telHref, whatsappHref } from '@/lib/contact';

interface Props {
  title?: string;
  lead?: string;
  headingId?: string;
}

const {
  title = 'Projeniz hakkında konuşalım',
  lead = 'Sorularınız için telefon, WhatsApp veya e-posta ile bize doğrudan ulaşabilirsiniz.',
  headingId = 'iletisim-cta',
} = Astro.props;
const mobile = company.phones[0];
---

<section class="tone-dark" aria-labelledby={headingId}>
  <Container width="wide" class="py-section grid gap-10 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <Eyebrow>İletişim</Eyebrow>
      <h2 id={headingId} class="mt-5 text-5xl">
        {title}
      </h2>
      <p class="text-ink-muted mt-6 max-w-xl text-lg">{lead}</p>
    </div>
    <div class="flex flex-col gap-4 lg:col-span-5 lg:items-end">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button
          href={whatsappHref(company.whatsapp.e164)}
          external
          leadingIcon="whatsapp"
          size="lg"
        >
          WhatsApp ile yazın
        </Button>
        <Button href={telHref(mobile.e164)} variant="secondary" leadingIcon="phone" size="lg">
          {mobile.display}
        </Button>
      </div>
      <TextLink href={mailtoHref(company.email)}>{company.email}</TextLink>
    </div>
  </Container>
</section>
