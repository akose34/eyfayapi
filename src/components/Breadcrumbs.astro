---
/**
 * Breadcrumb trail (WAI-ARIA breadcrumb pattern) + schema.org BreadcrumbList.
 * The last item is the current page: rendered as text with aria-current.
 */
import Icon from './Icon.astro';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  /** Landmark label; must be unique if several breadcrumbs share a page. */
  label?: string;
  class?: string | undefined;
}

const { items, label = 'Sayfa konumu', class: className } = Astro.props;
const trail: Crumb[] = [{ label: 'Ana Sayfa', href: '/' }, ...items];
const site = Astro.site ?? new URL('https://eyfayapi.net');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    item: new URL(crumb.href ?? Astro.url.pathname, site).toString(),
  })),
}).replace(/</g, '\\u003c');
---

<nav aria-label={label} class:list={['text-sm', className]}>
  <ol class="text-ink-muted flex flex-wrap items-center gap-x-2 gap-y-1">
    {trail.map((crumb, index) => {
      const isLast = index === trail.length - 1;
      return (
        <li class="flex items-center gap-2">
          {isLast || !crumb.href ? (
            <span aria-current={isLast ? 'page' : undefined} class="text-ink">
              {crumb.label}
            </span>
          ) : (
            <a href={crumb.href} class="link-underline hover:text-ink transition-colors">
              {crumb.label}
            </a>
          )}
          {!isLast && <Icon name="chevron-right" size={14} class="text-accent-text" />}
        </li>
      );
    })}
  </ol>
</nav>
<script type="application/ld+json" set:html={jsonLd} />
