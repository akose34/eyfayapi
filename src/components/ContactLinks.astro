---
/**
 * Verified contact channels as a definition-style list with icons.
 * Tone-aware: inherits text colours from the surrounding surface.
 */
import Icon, { type IconName } from './Icon.astro';
import { contact } from '@/data/company';

interface Props {
  /** Include the postal address row. */
  address?: boolean;
  class?: string | undefined;
}
const { address = false, class: className } = Astro.props;

interface Row {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
  external?: boolean;
}

// Every value and link comes from the central `contact` source (company.ts).
const rows: Row[] = [
  {
    icon: 'phone',
    label: contact.mobile.label,
    value: contact.mobile.display,
    href: contact.mobile.href,
  },
  {
    icon: 'phone',
    label: contact.landline.label,
    value: contact.landline.display,
    href: contact.landline.href,
  },
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: contact.whatsapp.display,
    href: contact.whatsapp.href,
    external: true,
  },
  { icon: 'mail', label: 'E-posta', value: contact.email.value, href: contact.email.href },
  {
    icon: 'instagram',
    label: 'Instagram',
    value: contact.instagram.handle,
    href: contact.instagram.url,
    external: true,
  },
  ...(address
    ? [
        {
          icon: 'map-pin' as const,
          label: 'Adres',
          value: contact.address.line,
          href: contact.address.directionsHref,
          external: true,
        },
      ]
    : []),
];
---

<dl class:list={['grid gap-5 text-sm', className]}>
  {rows.map((row) => (
    <div class="grid grid-cols-[1.25rem_1fr] gap-x-3">
      <Icon name={row.icon} size={18} class="text-accent-text mt-0.5" />
      <dt class="text-ink-muted text-xs tracking-(--tracking-ui)">{row.label}</dt>
      <dd class="col-start-2 font-medium">
        {row.href ? (
          <a
            href={row.href}
            class="link-underline hover:text-accent-text transition-colors"
            {...(row.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {row.value}
            {row.external && <span class="sr-only"> (yeni sekmede açılır)</span>}
          </a>
        ) : (
          <span>{row.value}</span>
        )}
      </dd>
    </div>
  ))}
</dl>
