---
import { company } from '@/data/company';
import { mailtoHref, telHref, whatsappHref } from '@/lib/contact';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const muted = tone === 'dark' ? 'text-ink-inverse-muted' : 'text-ink-muted';
const instagram = company.social[0];
---

<ul class="space-y-3 text-sm">
  {company.phones.map((phone) => (
    <li>
      <span class:list={['block', muted]}>{phone.kind === 'mobile' ? 'Cep' : 'Telefon'}</span>
      <a href={telHref(phone.e164)} class="hover:text-champagne font-medium">
        {phone.display}
      </a>
    </li>
  ))}
  <li>
    <span class:list={['block', muted]}>WhatsApp</span>
    <a
      href={whatsappHref(company.whatsapp.e164)}
      class="hover:text-champagne font-medium"
      target="_blank"
      rel="noopener noreferrer"
    >
      {company.whatsapp.display}
      <span class="sr-only"> (yeni sekmede açılır)</span>
    </a>
  </li>
  <li>
    <span class:list={['block', muted]}>E-posta</span>
    <a href={mailtoHref(company.email)} class="hover:text-champagne font-medium">
      {company.email}
    </a>
  </li>
  <li>
    <span class:list={['block', muted]}>Instagram</span>
    <a
      href={instagram.url}
      class="hover:text-champagne font-medium"
      target="_blank"
      rel="noopener noreferrer"
    >
      {instagram.handle}
      <span class="sr-only"> (yeni sekmede açılır)</span>
    </a>
  </li>
</ul>
