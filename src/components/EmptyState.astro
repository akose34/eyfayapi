---
/**
 * Calm placeholder for content that does not exist yet (e.g. a filter with
 * no results, or a section awaiting owner content). Never fills the gap with
 * invented copy.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  icon?: IconName;
  class?: string | undefined;
}
const { title, description, icon = 'image-off', class: className } = Astro.props;
---

<div
  class:list={[
    'border-line-strong/50 flex flex-col items-center rounded-lg border border-dashed px-6 py-14 text-center',
    className,
  ]}
>
  <Icon name={icon} size={28} class="text-accent-text" />
  <p class="font-display mt-4 text-2xl">{title}</p>
  {description && <p class="text-ink-muted mt-2 max-w-md text-sm">{description}</p>}
  {Astro.slots.has('default') && (
    <div class="mt-6">
      <slot />
    </div>
  )}
</div>
