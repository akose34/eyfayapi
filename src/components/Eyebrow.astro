---
/** Small uppercase label above headings, preceded by a short gold rule. */
interface Props {
  rule?: boolean;
  class?: string | undefined;
}
const { rule = true, class: className } = Astro.props;
---

<p class:list={['eyebrow flex items-center gap-3', className]}>
  {rule && <span aria-hidden="true" class="bg-accent h-px w-8" />}
  <span>
    <slot />
  </span>
</p>
