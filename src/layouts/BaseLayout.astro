---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { company, contact, legacyCopy } from '@/data/company';
import { OG_HEIGHT, OG_WIDTH, ogAlt, ogImagePath, type OgKey } from '@/data/og';
import { legacyImage } from '@/lib/media';
import {
  SITE_NAME,
  canonicalUrl,
  indexingDisabled,
  jsonLdString,
  pageTitle,
  robotsContent,
} from '@/lib/seo';

interface Props {
  /** Page title without the brand suffix. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Sharing image key (src/data/og.ts). Defaults to the logo-only image. */
  og?: OgKey;
  /** Keep placeholder / unconfirmed pages out of search indexes (links still followed). */
  noindex?: boolean;
  /** false: no canonical link (error pages have no canonical URL). */
  canonical?: boolean;
}

const {
  title,
  description = legacyCopy.metaDescription,
  og = 'default',
  noindex = false,
  canonical: hasCanonical = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://eyfayapi.net');
const fullTitle = pageTitle(title);
const canonical = canonicalUrl(Astro.url.pathname, site);
const robots = robotsContent({ noindex: noindex || indexingDisabled() });
const ogUrl = new URL(ogImagePath(og), site).toString();
const ogImageAlt = ogAlt(og);
const favicon = await getImage({ src: legacyImage('logos/logo.png'), width: 64, format: 'png' });
const touchIcon = await getImage({ src: legacyImage('logos/logo.png'), width: 180, format: 'png' });
const logo = await getImage({ src: legacyImage('logos/logo.png'), width: 512, format: 'png' });
const orgId = new URL('/#organization', site).toString();
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks JS availability before first paint (progressive enhancement of the mobile menu). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {hasCanonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#151C1E" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script
      type="application/ld+json"
      set:html={jsonLdString({
        '@context': 'https://schema.org',
        '@graph': [
          {
            // GeneralContractor (a LocalBusiness subtype): the registered legal name is
            // "EYFA MÜTEAHHİTLİK YAPI İNŞAAT…" — müteahhitlik = construction contracting.
            '@type': 'GeneralContractor',
            '@id': orgId,
            name: company.brandName,
            legalName: company.legalName,
            url: site.toString(),
            logo: new URL(logo.src, site).toString(),
            image: new URL(ogImagePath('home'), site).toString(),
            email: company.email,
            telephone: company.phones.map((p) => p.e164),
            foundingDate: String(company.foundedYear.value),
            founder: { '@type': 'Person', name: company.founder.value },
            address: {
              '@type': 'PostalAddress',
              streetAddress: company.address.street,
              postalCode: company.address.postalCode,
              addressLocality: company.address.district,
              addressRegion: company.address.city,
              addressCountry: company.address.country,
            },
            hasMap: contact.address.directionsHref,
            sameAs: company.social.map((s) => s.url),
            contactPoint: [contact.mobile, contact.landline].map((phone) => ({
              '@type': 'ContactPoint',
              telephone: phone.e164,
              contactType: 'customer service',
              availableLanguage: 'tr',
            })),
            // Deliberately absent (no verified source): openingHours, geo, areaServed,
            // aggregateRating/review, award, hasCredential, priceRange.
          },
          {
            '@type': 'WebSite',
            '@id': new URL('/#website', site).toString(),
            url: site.toString(),
            name: SITE_NAME,
            inLanguage: 'tr-TR',
            publisher: { '@id': orgId },
          },
        ],
      })}
    />
  </head>
  <body class="bg-surface text-ink flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-accent text-on-accent sr-only z-(--z-skip-link) rounded-md px-5 py-3 text-sm font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      İçeriğe geç
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
